{
  "name": "giwa-learn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": "22.x"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:contracts": "hardhat test",
    "test:e2e": "playwright test",
    "deploy:local": "hardhat ignition deploy ignition/modules/GiwaLearn.ts",
    "deploy:giwa": "hardhat ignition deploy ignition/modules/GiwaLearn.ts --network giwaSepolia",
    "react:doctor": "pnpm dlx react-doctor@latest",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm test:contracts && pnpm build"
  },
  "dependencies": {
    "@fontsource-variable/noto-sans-kr": "5.2.10",
    "@fontsource-variable/space-grotesk": "5.2.10",
    "@openzeppelin/contracts": "5.6.1",
    "@radix-ui/react-icons": "1.3.2",
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "viem": "2.55.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@nomicfoundation/hardhat-ignition": "3.1.8",
    "@nomicfoundation/hardhat-toolbox-viem": "5.0.7",
    "@nomicfoundation/hardhat-verify": "3.0.21",
    "@playwright/test": "1.61.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "^24.10.0",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "dotenv": "17.4.2",
    "hardhat": "3.9.1",
    "jsdom": "29.1.1",
    "react-grab": "0.1.48",
    "react-scan": "0.5.7",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
